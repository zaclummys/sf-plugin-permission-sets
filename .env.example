# Template for the local .env the test suite reads. Copy it, fill in the value, and keep
# the copy out of git: `cp .env.example .env`. This file is the committed contract, so add
# a variable here (with no real value) whenever the suite starts depending on one.
#
# Anything already set in the environment wins over .env, which is how CI passes these in
# without a file. See the Development section of the README.

# Required. Username or alias of an already-authenticated org the real-org specs (plan,
# apply, export) run against. The apply specs exercise the real write path, so use a
# sandbox or a scratch org, never production.
PS_TARGET_ORG=

# Only for `npm run test:nuts:org`, which creates a scratch org of its own. Name an
# already-authenticated Dev Hub and the testkit copies that authentication into the
# throwaway home it runs under. `npm test` and `npm run test:nuts` never read it.
TESTKIT_HUB_USERNAME=

# Alternative to the above, and what CI uses: an sfdx auth url for the Dev Hub, from
# `sf org display --verbose --target-org <devhub>`. Set one or the other, not both.
TESTKIT_AUTH_URL=
