{
    "temp-directory": ".unit-coverage",
    "reports-dir": "coverage/gate",
    "all": true,
    "extension": [".js"],
    "include": [
        "lib/core/**",
        "lib/services/**",
        "lib/ui/**"
    ],
    "exclude": [
        "lib/core/model.js",
        "lib/services/adapters/**"
    ],
    "reporter": ["text"],
    "check-coverage": true,
    "statements": 100,
    "branches": 100,
    "functions": 100,
    "lines": 100
}
